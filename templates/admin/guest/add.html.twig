{% extends 'admin.html.twig' %}

{% block admin %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Ajouter un invité</h1>
        <a href="{{ path('admin_guest_index') }}" class="btn btn-secondary">Retour</a>
    </div>

    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.email) }}
        {{ form_row(form.plainPassword) }}
        {{ form_row(form.description) }}
        <button type="submit" class="btn btn-primary mt-2">Créer l'invité</button>
    {{ form_end(form) }}
{% endblock %}
