{% extends 'admin.html.twig' %}

{% block admin %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Invités</h1>
        <a href="{{ path('admin_guest_add') }}" class="btn btn-primary">Ajouter un invité</a>
    </div>

    {% if guests is empty %}
        <p class="text-muted">Aucun invité pour le moment.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>E-mail</th>
                    <th>Statut</th>
                    <th>Médias</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for guest in guests %}
                    <tr>
                        <td>{{ guest.name }}</td>
                        <td>{{ guest.email }}</td>
                        <td>
                            {% if guest.blocked %}
                                <span class="badge bg-danger">Bloqué</span>
                            {% else %}
                                <span class="badge bg-success">Actif</span>
                            {% endif %}
                        </td>
                        <td>{{ guest.medias|length }}</td>
                        <td class="d-flex gap-2">
                            <a href="{{ path('admin_guest_toggle', {id: guest.id}) }}"
                               class="btn btn-sm {{ guest.blocked ? 'btn-success' : 'btn-warning' }}">
                                {{ guest.blocked ? 'Débloquer' : 'Bloquer' }}
                            </a>
                            <a href="{{ path('admin_guest_delete', {id: guest.id}) }}"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Supprimer {{ guest.name }} et tous ses médias ?')">
                                Supprimer
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
